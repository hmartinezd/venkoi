{
  "name": "venkoi",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build:next": "next build --no-lint",
    "build": "npm run lint && npm run typecheck && npm run build:next",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:routing": "tsx scripts/test-routing-regression.ts",
    "test:navigation": "tsx scripts/test-navigation-intent.ts",
    "test:site-config": "tsx scripts/test-site-config.ts",
    "test:contact": "tsx scripts/test-contact-config.ts",
    "test:leads": "tsx scripts/test-lead-flow.ts",
    "test:seo": "tsx scripts/test-seo-regression.ts",
    "test:regression": "npm run test:routing && npm run test:navigation && npm run test:site-config && npm run test:contact && npm run test:leads && npm run test:seo",
    "quality": "npm run lint && npm run typecheck && npm run test:regression && npm run build:next"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "next": "^15.5.23",
    "next-intl": "^3.26.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.18.1",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "prettier": "^2.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0"
  }
}
