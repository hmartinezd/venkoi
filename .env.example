# Server-only: Neon Serverless PostgreSQL connection URL used to persist leads.
# Leave blank unless local lead persistence is being tested.
DATABASE_URL=

# Server-only secret: Resend API key used for lead notifications and acknowledgements.
RESEND_API_KEY=

# Server-only: verified Resend sending domain only (no scheme or email address).
RESEND_EMAIL_DOMAIN=send.venkoi.com

# Server-only: operational recipient for internal lead notifications (example format: leads@venkoi.com).
LEADS_NOTIFICATION_EMAIL=

# Canonical public origin used by server-generated URLs and SEO metadata.
# Production must use https://venkoi.com; previews should retain that canonical origin.
SITE_URL=https://venkoi.com
