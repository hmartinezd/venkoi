# PostgreSQL database connection URL (Neon Serverless PostgreSQL)
DATABASE_URL=

# Resend API Key for sending transactional lead notifications & user acknowledgements
RESEND_API_KEY=

# Verified sender email address in Resend (e.g., Venkoi <notifications@venkoi.com>)
RESEND_FROM_EMAIL=

# Recipient email address for internal lead notification alerts
LEADS_NOTIFICATION_EMAIL=

# Public Canonical Site Origin URL (defaults to https://venkoi.com)
SITE_URL=https://venkoi.com
